# Install to /etc/elab-job-dispatcher.env  (fill in ELAB_APIKEY; chmod 600)
# Use the same read-capable eLab API key the other cron tools use. Do NOT commit the real key.
ELAB_APIKEY=PUT_THE_ELAB_API_KEY_HERE
ELAB_BASE=https://localhost/api/v2
AZ_SUB=YOUR-AZURE-SUBSCRIPTION-ID
AZ_RG=YOUR-RESOURCE-GROUP
AZ_JOB=coloc-worker
AZ_JOB_GCAMP=gcamp-worker
