# Copy to blob-upload.env (git-ignored) and fill in. Load it into the relay service.
# The relay uses the host's managed identity for storage auth — no keys here.

BLOB_ACCT=YOUR-STORAGE-ACCOUNT
BLOB_CONTAINER=microscopy
BLOB_ALLOWED_CONTAINERS=microscopy
# ELN base used to validate the caller's session cookie:
ELAB_BASE=https://YOUR-ELN-HOST/api/v2
